# Django Settings
SECRET_KEY=django-insecure-example-key-change-this-in-production
DEBUG=True

# Database Configuration
DB_ENGINE=sqlite  # Use 'sqlite' for development, 'postgres' for production
# For SQLite (development) - no additional DB settings needed

# For PostgreSQL (production) - uncomment and configure these:
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password
# DB_HOST=localhost
# DB_PORT=5432

# Media Files
MEDIA_ROOT=db-media

# Example for development
# Copy this file to .env and update values as needed